{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/khhvmc5g6f-eng/Neurodiversity/schemas/result-schema.json",
  "title": "NEURODIVERSITY result",
  "description": "The distilled, user-facing output of an NEURODIVERSITY run (Synthesis B). Every array entry should carry an evidence pointer where possible.",
  "type": "object",
  "required": ["systemMap", "attentionTunnels", "verifiedFindings", "recommendations", "confidence"],
  "properties": {
    "divergentOptions": {
      "type": "object",
      "description": "Populated only when Phase D (divergence.md) ran. Structured, not prose.",
      "properties": {
        "candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["text", "cluster"],
            "properties": {
              "text": { "type": "string" },
              "rationale": { "type": "string" },
              "frame": { "type": "string" },
              "cluster": { "type": "string" },
              "novelty": { "type": "number", "minimum": 0, "maximum": 10 },
              "viability": { "type": "number", "minimum": 0, "maximum": 10 },
              "fit": { "type": "number", "minimum": 0, "maximum": 10 },
              "isTrap": { "type": "boolean", "default": false },
              "trapReason": { "type": "string" }
            }
          }
        },
        "shortlist": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["text", "why"],
            "properties": {
              "text": { "type": "string" },
              "why": { "type": "string" },
              "nonObviousPick": { "type": "boolean", "default": false },
              "sketch": { "type": "string" },
              "loadBearingRisk": { "type": "string" },
              "firstStep": { "type": "string" },
              "childIdeas": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "systemMap": { "$ref": "system-map.schema.json" },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["req", "status"],
        "properties": {
          "req": { "type": "string" },
          "negative": { "type": "boolean", "default": false },
          "implementation": { "type": "string" },
          "test": { "type": "string" },
          "status": { "enum": ["unmapped", "mapped", "implemented", "tested"] }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim", "requires"],
        "properties": {
          "claim": { "type": "string" },
          "requires": { "type": "array", "items": { "type": "string" }, "description": "IDs of assumptions this one depends on" },
          "blastRadius": { "enum": ["low", "medium", "high", "critical"] },
          "verified": { "type": "boolean" }
        }
      }
    },
    "dependencies": { "type": "array", "items": { "type": "object" } },
    "invariants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule"],
        "properties": {
          "rule": { "type": "string" },
          "violationPathsFound": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "attentionTunnels": {
      "type": "array",
      "items": { "$ref": "tunnel.schema.json" }
    },
    "patterns": { "type": "array", "items": { "type": "object" } },
    "contradictions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["description", "sources"],
        "properties": {
          "description": { "type": "string" },
          "sources": { "type": "array", "items": { "type": "string" } },
          "impact": { "type": "number" },
          "certainty": { "type": "number" },
          "reach": { "type": "number" }
        }
      }
    },
    "edgeCases": { "type": "array", "items": { "type": "object" } },
    "failureModes": { "type": "array", "items": { "type": "object" } },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["question", "materiality"],
        "properties": {
          "question": { "type": "string" },
          "materiality": { "enum": ["blocking", "high", "medium", "low", "curiosity"] }
        }
      }
    },
    "verifiedFindings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["finding", "evidence", "confidence"],
        "properties": {
          "finding": { "type": "string" },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "file": { "type": "string" },
                "symbol": { "type": "string" },
                "test": { "type": "string" },
                "externalSource": { "type": "string" },
                "observation": { "type": "string" }
              }
            }
          },
          "falsificationAttempted": { "type": "boolean" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["recommendation", "why"],
        "properties": {
          "recommendation": { "type": "string" },
          "why": { "type": "array", "items": { "type": "string" }, "description": "chain: recommendation -> finding -> evidence -> requirement" },
          "implementationSequence": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "tests": { "type": "array", "items": { "type": "string" } },
    "readinessState": {
      "enum": ["not_understood", "partially_mapped", "understood_with_gaps", "implementation_ready", "verified"]
    },
    "hardFailureStates": {
      "type": "array",
      "items": {
        "enum": [
          "critical_assumption_unresolved",
          "critical_contradiction_unresolved",
          "core_requirement_unmapped",
          "major_claim_unverified",
          "test_failure",
          "root_cause_unknown"
        ]
      }
    },
    "confidence": {
      "type": "object",
      "description": "Overall calibration inputs, not a single vibe score",
      "properties": {
        "directEvidence": { "type": "number" },
        "independentConfirmation": { "type": "number" },
        "testResult": { "type": "number" },
        "unresolvedAssumptionCount": { "type": "integer" },
        "unresolvedContradictionCount": { "type": "integer" }
      }
    }
  }
}
