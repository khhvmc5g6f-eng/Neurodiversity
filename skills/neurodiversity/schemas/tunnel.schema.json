{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/khhvmc5g6f-eng/neurodiversity-coding/schemas/tunnel.schema.json",
  "title": "Attention tunnel",
  "description": "One sustained monotropic investigation. See SKILL.md Phase 2.",
  "type": "object",
  "required": ["id", "subject", "whyMaterial", "openQuestions", "stoppingCondition", "status"],
  "properties": {
    "id": { "type": "string", "pattern": "^AT-[0-9]+$" },
    "subject": { "type": "string" },
    "whyMaterial": { "type": "string", "description": "Why this question matters -- the blast radius or symptom it explains" },
    "currentDepth": { "type": "integer", "minimum": 0, "default": 0 },
    "openQuestions": { "type": "array", "items": { "type": "string" } },
    "dependencies": { "type": "array", "items": { "type": "string" }, "description": "other tunnel IDs or system-map node IDs this depends on" },
    "evidence": { "type": "array", "items": { "type": "object" } },
    "contradictions": { "type": "array", "items": { "type": "string" } },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "stoppingCondition": { "type": "string", "description": "what would count as this tunnel being saturated" },
    "status": {
      "enum": ["active", "waiting", "saturated", "stalled", "looping", "failed", "complete"]
    },
    "detailValue": {
      "type": "object",
      "properties": {
        "impact": { "type": "number", "minimum": 0, "maximum": 3 },
        "uncertainty": { "type": "number", "minimum": 0, "maximum": 3 },
        "reach": { "type": "number", "minimum": 0, "maximum": 3 },
        "score": { "type": "number", "description": "impact * uncertainty * reach" }
      }
    },
    "hyperfocusChecks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "atDepth": { "type": "integer" },
          "stillHighestValue": { "type": "boolean" },
          "action": { "enum": ["continued", "switched"] }
        }
      }
    },
    "transition": {
      "type": "object",
      "description": "populated when the tunnel is closed or paused",
      "properties": {
        "whereWeWere": { "type": "string" },
        "whatWasResolved": { "type": "string" },
        "whatRemains": { "type": "string" },
        "whySwitching": { "type": "string" }
      }
    }
  }
}
