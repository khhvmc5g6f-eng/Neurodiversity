{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/khhvmc5g6f-eng/neurodiversity-coding/schemas/system-map.schema.json",
  "title": "System map",
  "description": "Typed graph produced by Phase 0 System Cartography. See references/architecture.md",
  "type": "object",
  "required": ["nodes", "edges"],
  "properties": {
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "name"],
        "properties": {
          "id": { "type": "string" },
          "kind": {
            "enum": [
              "actor", "component", "service", "data", "state",
              "external_system", "configuration", "security_boundary",
              "failure_boundary", "event", "interface"
            ]
          },
          "name": { "type": "string" },
          "layer": { "enum": ["micro", "meso", "macro"] },
          "boundaryOrigin": {
            "enum": ["explicit", "inferred"],
            "description": "security_boundary nodes only: 'explicit' if an obvious auth check/middleware labels it, 'inferred' if found via the implicit-boundary checklist in references/architecture.md (external input reaching a sensitive sink with no obvious check nearby)."
          },
          "justification": {
            "type": "string",
            "description": "Required when boundaryOrigin is 'inferred' -- which external input and which sensitive sink triggered the inference. Keeps inferred boundaries traceable to evidence rather than invented."
          },
          "checkPresent": {
            "type": "boolean",
            "description": "security_boundary nodes only: whether an authorization/validation step was actually found between the input and the sink. false is itself a candidate finding, not just a note -- feed it to the STRIDE pass."
          },
          "loadBearingScore": {
            "type": "object",
            "properties": {
              "centrality": { "type": "number" },
              "dependencyCount": { "type": "number" },
              "failureImpact": { "type": "number" },
              "replaceability": { "type": "number" },
              "observability": { "type": "number" },
              "score": { "type": "number" }
            }
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "type"],
        "properties": {
          "from": { "type": "string" },
          "to": { "type": "string" },
          "type": {
            "enum": [
              "CALLS", "READS", "WRITES", "DEPENDS_ON", "TRIGGERS",
              "VALIDATES", "AUTHENTICATES", "AUTHORIZES", "OBSERVES",
              "CACHES", "TRANSFORMS", "SERIALISES", "CONSUMES",
              "PRODUCES", "OWNS", "BLOCKS", "RETRIES", "INVALIDATES"
            ]
          }
        }
      }
    }
  }
}
